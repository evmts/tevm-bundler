{
	"extends": "@tevm/tsconfig/base.json",
	"compilerOptions": {
		"outDir": "types",
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"incremental": false,
		"ignoreDeprecations": "6.0"
	},
	"include": ["src", "src/**/*.json", "package.json"]
}
