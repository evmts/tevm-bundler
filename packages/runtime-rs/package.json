{
	"name": "@tevm/runtime-rs",
	"version": "1.0.0-rc.151",
	"private": false,
	"description": "Rust implementation of Tevm runtime",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/tevm-bundler.git",
		"directory": "packages/runtime-rs"
	},
	"license": "MIT",
	"type": "commonjs",
	"main": "index.js",
	"types": "index.d.ts",
	"files": [
		"index.js",
		"index.d.ts",
		"README.md"
	],
	"scripts": {
		"build": "cargo build --release",
		"build:debug": "cargo build",
		"build:napi": "napi build --platform --release",
		"build:release": "cargo build --release",
		"prepublishOnly": "napi pre-publish --tag-style npm",
		"test": "cargo test",
		"typecheck": "cargo check",
		"test:run": "cargo test"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.6.2"
	},
	"engines": {
		"node": ">= 14"
	},
	"napi": {
		"binaryName": "tevm_runtime_rs",
		"packageName": "@tevm/runtime-rs",
		"targets": [
			"aarch64-apple-darwin",
			"aarch64-unknown-linux-gnu",
			"aarch64-unknown-linux-musl",
			"aarch64-pc-windows-msvc",
			"armv7-unknown-linux-gnueabihf",
			"x86_64-unknown-linux-gnu",
			"x86_64-unknown-linux-musl",
			"x86_64-apple-darwin",
			"x86_64-unknown-freebsd",
			"x86_64-pc-windows-msvc",
			"i686-pc-windows-msvc"
		]
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
